{
  "name": "twelve",
  "version": "0.0.0",
  "private": true,
  "description": "Twelve — creative studio for digital things worth making",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tokens:build": "node scripts/tokens.mjs",
    "tokens:check": "node scripts/tokens.mjs --check && node scripts/check-design-tokens.mjs",
    "domain:check": "node scripts/check-domain.mjs",
    "budget": "node scripts/check-budget.mjs",
    "a11y": "node scripts/check-a11y.mjs"
  },
  "dependencies": {
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver",
      "chromedriver"
    ]
  }
}
